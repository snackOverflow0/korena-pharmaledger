# Copy to .env (private; do not share or commit)
# Generate a long random key, e.g. Python: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD
ADMIN_EMAIL=admin@korena.local
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_10_CHARACTERS
# 0: HTTP local test only; 1: secure HTTPS deployment behind a TLS reverse proxy
KORENA_HTTPS=0
