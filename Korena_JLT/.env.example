# Edit before starting. XAMPP MySQL/MariaDB MUST be running.
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/pharma_ledger?charset=utf8mb4
# If you set a MySQL root password, replace root:@ with root:YOUR_PASSWORD@
# For an offline SQLite demo instead, use: DATABASE_URL=sqlite:///pharma_demo.db
FLASK_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_FOR_THIS_COMPUTER
ADMIN_EMAIL=admin@pharmaledger.local
INITIAL_ADMIN_PASSWORD=ChangeThisPassword123!
PORT=5000
